<Window x:Class="TomatoTime.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TomatoTime.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="TomatoTime" Height="660" Width="480"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- 统计页 DataTemplate -->
    <DataTemplate DataType="{x:Type vm:StatsViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="6,4">
          <Button Content="◀" Command="{Binding PrevCommand}" Padding="8,2" Margin="0,0,4,0"/>
          <Button Content="日" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:StatsRange.Day}" Margin="0,0,4,0" Padding="10,2"/>
          <Button Content="周" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:StatsRange.Week}" Margin="0,0,4,0" Padding="10,2"/>
          <Button Content="月" Command="{Binding SetRangeCommand}" CommandParameter="{x:Static vm:StatsRange.Month}" Margin="0,0,4,0" Padding="10,2"/>
          <Button Content="▶" Command="{Binding NextCommand}" Padding="8,2" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding ViewTitle}" VerticalAlignment="Center" Opacity="0.7"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="8,2" TextElement.FontSize="16">
          <TextBlock Text="{Binding PomodoroKpi}" FontWeight="Bold" Foreground="#D63630"/>
          <TextBlock Text=" 番茄" VerticalAlignment="Bottom" Margin="0,0,14,0" Opacity="0.8"/>
          <TextBlock Text="{Binding DurationKpi}" FontWeight="Bold"/>
          <TextBlock Text=" 时长" VerticalAlignment="Bottom" Margin="0,0,14,0" Opacity="0.8"/>
          <TextBlock Text="{Binding DailyAvgKpi}" VerticalAlignment="Bottom" Margin="0,0,14,0" Opacity="0.8"/>
          <TextBlock Text="{Binding ExtraKpi}" VerticalAlignment="Bottom" Opacity="0.8"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="6">
          <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" TooltipPosition="Hidden"/>
          <TextBlock Text="今天还没有完成番茄" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding Series[0].Values.Count, Converter={x:Static vm:EmptyToCollapsedConverter.Instance}, FallbackValue=Collapsed}"/>
        </Grid>

        <GroupBox Grid.Row="3" Header="按任务分布" Margin="6,0,6,6">
          <DataGrid ItemsSource="{Binding BreakdownRows}" AutoGenerateColumns="True" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"/>
        </GroupBox>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 顶部计时视图 -->
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,18,0,10">
      <TextBlock Text="{Binding PhaseLabel}" FontSize="16" HorizontalAlignment="Center" Opacity="0.7"/>
      <TextBlock Text="{Binding RemainingText}" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding CurrentTaskTitle}" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,10" Opacity="0.8"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="开始" Command="{Binding StartCommand}" Padding="16,6" Margin="4"
                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"/>
        <Button Content="暂停" Command="{Binding PauseCommand}" Padding="16,6" Margin="4"
                Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"/>
        <Button Content="继续" Command="{Binding ResumeCommand}" Padding="16,6" Margin="4"
                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"/>
        <Button Content="跳过" Command="{Binding SkipCommand}" Padding="16,6" Margin="4"
                IsEnabled="{Binding CanControl}"/>
        <Button Content="停止" Command="{Binding StopCommand}" Padding="16,6" Margin="4"
                IsEnabled="{Binding CanControl}"/>
      </StackPanel>
    </StackPanel>

    <!-- Tab 区:今日待办 | 统计 | 设置 -->
    <TabControl Grid.Row="1" Margin="10,0,10,10">
      <TabItem Header="今日待办">
        <Grid Margin="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="今日待办" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,6"/>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="今日没有任务,加一个开始专注" Opacity="0.5" HorizontalAlignment="Center" Margin="0,16">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Tasks.Pending.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Tasks.Pending}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,3">
                      <Button Content="✕" DockPanel.Dock="Right" Width="22" ToolTip="删除"
                              Command="{Binding DataContext.Tasks.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#999"/>
                      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,6,0" Opacity="0.6"
                                 Text="{Binding TodayPomodoros, StringFormat='🍅 {0}'}"/>
                      <CheckBox VerticalAlignment="Center" ToolTip="设为当前任务"
                                IsChecked="{Binding IsActive}"
                                Command="{Binding DataContext.Tasks.ActivateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                        <TextBlock Text="{Binding Title}" Margin="6,0" TextTrimming="CharacterEllipsis"/>
                      </CheckBox>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Content="添加" DockPanel.Dock="Right" Command="{Binding Tasks.AddCommand}" Margin="6,0,0,0" Padding="12,4"/>
            <TextBox Text="{Binding Tasks.NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="NewTask_KeyDown" Padding="4,3"/>
          </DockPanel>

          <Expander Grid.Row="3" Margin="0,8,0,0" IsExpanded="{Binding Tasks.ShowCompleted}"
                    Header="{Binding Tasks.CompletedCount, StringFormat='今日已完成 ({0})'}">
            <ListBox ItemsSource="{Binding Tasks.Completed}" MaxHeight="140">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Right" Opacity="0.6" Margin="10,0,4,0"
                               Text="{Binding TodayPomodoros, StringFormat='🍅 {0}'}"/>
                    <TextBlock Text="{Binding Title}" TextDecorations="Strikethrough" Opacity="0.7"
                               TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>
        </Grid>
      </TabItem>

      <TabItem Header="统计">
        <ContentControl Content="{Binding Stats}"/>
      </TabItem>

      <TabItem Header="设置">
        <StackPanel Margin="20" VerticalAlignment="Top">
          <TextBlock Text="常规设置请打开设置窗口调整。" Opacity="0.7" Margin="0,0,0,12"/>
          <Button Content="打开设置窗口…" Command="{Binding OpenSettingsCommand}" Padding="16,8" HorizontalAlignment="Left"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
