<Window x:Class="TomatoTime.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="190" Height="56" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" MouseLeftButtonDown="OnDrag" MouseDoubleClick="OnDoubleClick">
  <Window.ContextMenu>
    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="展开主窗" Command="{Binding ExpandCommand}"/>
      <Separator/>
      <MenuItem Header="退出 TomatoTime" Command="{Binding ExitCommand}"/>
    </ContextMenu>
  </Window.ContextMenu>

  <Border CornerRadius="10" Background="#A60A0F1A" BorderBrush="#55223052" BorderThickness="1">
    <DockPanel Margin="8,4">
      <Button DockPanel.Dock="Right" Content="⤢" Width="24" Background="Transparent"
              BorderThickness="0" Foreground="#AAE8EEF7" Command="{Binding ExpandCommand}"
              Margin="4,0,0,0" ToolTip="展开主窗" VerticalAlignment="Center" FontSize="13"/>
      <TextBlock Text="{Binding TaskTitle}" DockPanel.Dock="Right" Foreground="#99AAB8CC" FontSize="10"
                 VerticalAlignment="Center" Margin="8,0,2,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding RemainingText}" Foreground="White" FontSize="21" FontWeight="Bold"
                 FontFamily="Consolas" VerticalAlignment="Center">
        <TextBlock.Effect>
          <DropShadowEffect Color="#FF4D5E" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
        </TextBlock.Effect>
      </TextBlock>
    </DockPanel>
  </Border>
</Window>
