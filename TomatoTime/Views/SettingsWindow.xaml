<Window x:Class="TomatoTime.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="400" Height="600"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgGradient}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Margin="16" Padding="18" CornerRadius="10"
            Background="#101729" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
      <StackPanel>

        <TextBlock Text="番茄钟参数" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"
                   FontSize="15" Margin="0,0,0,6"/>
        <Rectangle Height="1" Fill="{StaticResource ControlBorderBrush}" Margin="0,0,0,12"/>

        <!-- 工作时长 -->
        <TextBlock Text="工作时长" Foreground="{StaticResource TextBrush}" FontSize="13"/>
        <DockPanel Margin="0,4,0,12">
          <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"
                     FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                     Text="{Binding WorkMinutes, StringFormat={}{0} 分钟}"/>
          <Slider Minimum="5" Maximum="90" Value="{Binding WorkMinutes}" TickFrequency="5"
                  IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 短休时长 -->
        <TextBlock Text="短休时长" Foreground="{StaticResource TextBrush}" FontSize="13"/>
        <DockPanel Margin="0,4,0,12">
          <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"
                     FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                     Text="{Binding ShortBreakMinutes, StringFormat={}{0} 分钟}"/>
          <Slider Minimum="1" Maximum="30" Value="{Binding ShortBreakMinutes}" TickFrequency="1"
                  IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 长休时长 -->
        <TextBlock Text="长休时长" Foreground="{StaticResource TextBrush}" FontSize="13"/>
        <DockPanel Margin="0,4,0,12">
          <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"
                     FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                     Text="{Binding LongBreakMinutes, StringFormat={}{0} 分钟}"/>
          <Slider Minimum="5" Maximum="60" Value="{Binding LongBreakMinutes}" TickFrequency="5"
                  IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 长休间隔 -->
        <TextBlock Text="长休间隔(每 N 个番茄)" Foreground="{StaticResource TextBrush}" FontSize="13"/>
        <DockPanel Margin="0,4,0,12">
          <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"
                     FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                     Text="{Binding LongBreakInterval, StringFormat={}{0} 个}"/>
          <Slider Minimum="2" Maximum="8" Value="{Binding LongBreakInterval}" TickFrequency="1"
                  IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 遮罩不透明度 -->
        <TextBlock Text="遮罩不透明度" Foreground="{StaticResource TextBrush}" FontSize="13"/>
        <DockPanel Margin="0,4,0,12">
          <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"
                     FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                     Text="{Binding OverlayOpacity, StringFormat={}{0:0%}}"/>
          <Slider Minimum="0.3" Maximum="0.9" Value="{Binding OverlayOpacity}" TickFrequency="0.1"
                  IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 铃声音量 -->
        <TextBlock Text="铃声音量" Foreground="{StaticResource TextBrush}" FontSize="13"/>
        <DockPanel Margin="0,4,0,12">
          <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"
                     FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                     Text="{Binding BellVolume, StringFormat={}{0}}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding BellVolume}" TickFrequency="10"
                  IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
        </DockPanel>

        <Rectangle Height="1" Fill="{StaticResource ControlBorderBrush}" Margin="0,2,0,12"/>

        <CheckBox Content="开机自启" IsChecked="{Binding StartWithWindows}" Margin="0,4,0,8"/>
        <CheckBox Content="启动时恢复上次计时" IsChecked="{Binding RestoreOnStartup}" Margin="0,4,0,14"/>

        <Button Content="保存设置" Command="{Binding SaveCommand}" Padding="24,9"
                HorizontalAlignment="Right" Style="{StaticResource AccentButton}"/>
      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>
