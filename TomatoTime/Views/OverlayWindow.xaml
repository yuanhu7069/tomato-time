<Window x:Class="TomatoTime.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Topmost="True" Background="#0B0F1A"
        ShowInTaskbar="False" ResizeMode="NoResize">
  <Grid Background="#0B0F1A">
    <Border Width="460" Padding="36,32" CornerRadius="16"
            Background="#161D31" BorderBrush="#2E3D5C" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="{Binding EndedLabel}" Foreground="White" FontSize="40" FontWeight="Bold"
                   HorizontalAlignment="Center">
          <TextBlock.Effect>
            <DropShadowEffect Color="#FF4D5E" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
          </TextBlock.Effect>
        </TextBlock>
        <TextBlock Text="{Binding HintLabel}" Foreground="#AAB8CC" FontSize="16" Margin="0,12"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding NextLabel}" Foreground="#00E5FF" FontSize="22" FontWeight="SemiBold"
                   Margin="0,2,0,28" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="开始下一段" Command="{Binding StartNextCommand}" Padding="30,13" Margin="10"
                  FontSize="16" Style="{StaticResource AccentButton}"/>
          <Button Content="稍后 1 分" Command="{Binding PostponeCommand}" Padding="30,13" Margin="10"
                  FontSize="16" Style="{StaticResource GhostButton}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
